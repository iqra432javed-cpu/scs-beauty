<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Success Chaser Stars — Premium Beauty & Wellness | Pakistan</title>
<meta name="description" content="Discover SCS — Pakistan's premier luxury beauty and wellness brand. Organic skincare serums, beauty creams, and wellness products crafted for radiant transformation.">
<meta property="og:title" content="Success Chaser Stars — Premium Beauty & Wellness">
<meta property="og:description" content="Pakistan's premier luxury beauty brand. Glow serums, beauty creams, skin polish and more.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --rose-gold: #B76E79;
    --soft-blush: #E8D6D0;
    --champagne: #D8B47A;
    --warm-ivory: #FAF5F0;
    --pure-white: #FFFFFF;
    --text-dark: #2D2D2D;
    --soft-bg: #FDF8F8;
    --muted-rose: #C97A8B;
    --deep-rose: #8B4A56;
    --light-champagne: #F5ECD8;
    --border-light: rgba(183,110,121,0.15);
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Inter', sans-serif;
    color: var(--text-dark);
    background: var(--soft-bg);
    overflow-x: hidden;
  }
  /* ── NAVIGATION ── */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
    padding: 0 5vw;
    height: 72px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(253,248,248,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-light);
    transition: all 0.3s ease;
  }
  .nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--rose-gold);
    letter-spacing: 0.02em;
    text-decoration: none;
    display: flex; align-items: center; gap: 8px;
  }
  .nav-logo span { color: var(--champagne); }
  .nav-links { display: flex; align-items: center; gap: 2rem; list-style: none; }
  .nav-links a {
    font-size: 0.82rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-dark); text-decoration: none; opacity: 0.75;
    transition: opacity 0.2s, color 0.2s;
  }
  .nav-links a:hover { opacity: 1; color: var(--rose-gold); }
  .nav-cta {
    background: var(--rose-gold);
    color: white !important; opacity: 1 !important;
    padding: 0.55rem 1.4rem;
    border-radius: 50px;
    font-size: 0.8rem !important;
    transition: background 0.2s, transform 0.15s !important;
  }
  .nav-cta:hover { background: var(--deep-rose) !important; transform: translateY(-1px); }
  .nav-hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 4px; }
  .nav-hamburger span { width: 22px; height: 1.5px; background: var(--text-dark); display: block; transition: all 0.3s; }

  /* ── HERO ── */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center;
    padding: 72px 5vw 0;
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, #FDF8F8 0%, #FAF5F0 40%, #F5E8E0 100%);
  }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0;
    pointer-events: none;
  }
  .hero-circle {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(183,110,121,0.08), transparent 70%);
  }
  .hero-circle-1 { width: 700px; height: 700px; top: -200px; right: -100px; }
  .hero-circle-2 { width: 500px; height: 500px; bottom: -100px; left: -150px; background: radial-gradient(circle, rgba(216,180,122,0.1), transparent 70%); }
  .hero-content {
    position: relative; z-index: 1;
    max-width: 580px;
    animation: fadeUp 1s ease both;
  }
  .hero-eyebrow {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--champagne); margin-bottom: 1.5rem;
    display: flex; align-items: center; gap: 12px;
  }
  .hero-eyebrow::before {
    content: ''; width: 40px; height: 1px; background: var(--champagne); display: block;
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 5.5vw, 5rem);
    font-weight: 500; line-height: 1.1;
    color: var(--text-dark);
    margin-bottom: 1.5rem;
  }
  .hero h1 em { font-style: italic; color: var(--rose-gold); }
  .hero-sub {
    font-size: 1.05rem; font-weight: 300; line-height: 1.8;
    color: #6B6B6B;
    margin-bottom: 2.5rem;
    max-width: 440px;
  }
  .hero-btns { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary {
    background: var(--rose-gold); color: white;
    padding: 0.85rem 2.2rem; border-radius: 50px;
    font-size: 0.85rem; font-weight: 500; letter-spacing: 0.05em;
    text-decoration: none; border: none; cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .btn-primary:hover { background: var(--deep-rose); transform: translateY(-2px); box-shadow: 0 8px 25px rgba(183,110,121,0.3); }
  .btn-secondary {
    background: transparent; color: var(--rose-gold);
    padding: 0.85rem 2.2rem; border-radius: 50px;
    font-size: 0.85rem; font-weight: 500; letter-spacing: 0.05em;
    text-decoration: none; border: 1.5px solid var(--rose-gold); cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex; align-items: center; gap: 8px;
  }
  .btn-secondary:hover { background: var(--rose-gold); color: white; transform: translateY(-2px); }
  .hero-visual {
    position: absolute; right: 5vw; top: 50%; transform: translateY(-50%);
    z-index: 1;
    animation: fadeLeft 1.2s ease 0.2s both;
  }
  .hero-card-stack {
    position: relative; width: 320px; height: 420px;
  }
  .hero-card {
    position: absolute;
    border-radius: 24px;
    background: white;
    box-shadow: 0 20px 60px rgba(183,110,121,0.12);
    overflow: hidden;
  }
  .hero-card-main {
    width: 260px; height: 340px;
    top: 40px; left: 30px;
    background: linear-gradient(160deg, var(--soft-blush), var(--warm-ivory));
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 2rem;
  }
  .hero-card-accent {
    width: 160px; height: 200px;
    top: 0; left: 0;
    background: linear-gradient(135deg, var(--champagne), #E8C88A);
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    padding: 1.5rem;
    transform: rotate(-6deg);
    z-index: 2;
  }
  .product-icon-hero {
    font-size: 3.5rem; margin-bottom: 0.75rem;
    filter: drop-shadow(0 4px 12px rgba(183,110,121,0.2));
  }
  .hero-card-main .product-icon-hero { font-size: 4rem; }
  .hero-card-label {
    font-family: 'Playfair Display', serif;
    font-size: 0.9rem; font-weight: 500;
    color: var(--text-dark); text-align: center;
  }
  .hero-card-accent .hero-card-label { font-size: 0.75rem; color: #5A4020; }
  .hero-badge {
    position: absolute; bottom: 20px; right: -10px;
    background: var(--rose-gold);
    color: white; border-radius: 50px;
    padding: 0.5rem 1rem;
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em;
    box-shadow: 0 6px 20px rgba(183,110,121,0.35);
    white-space: nowrap;
  }
  .hero-trust {
    position: relative; z-index: 1;
    margin-top: 3.5rem;
    display: flex; align-items: center; gap: 2rem;
    animation: fadeUp 1s ease 0.4s both;
  }
  .hero-trust-item { display: flex; flex-direction: column; }
  .trust-num {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem; font-weight: 600;
    color: var(--rose-gold);
  }
  .trust-label { font-size: 0.72rem; color: #999; letter-spacing: 0.05em; }
  .trust-divider { width: 1px; height: 32px; background: var(--border-light); }

  /* ── MARQUEE ── */
  .marquee-section {
    background: var(--rose-gold); overflow: hidden;
    padding: 0.85rem 0;
  }
  .marquee-track {
    display: flex; gap: 4rem;
    animation: marquee 25s linear infinite;
    white-space: nowrap;
  }
  .marquee-item {
    font-size: 0.72rem; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    display: flex; align-items: center; gap: 1rem;
    flex-shrink: 0;
  }
  .marquee-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--champagne); }

  /* ── SECTIONS GENERIC ── */
  section { padding: 6rem 5vw; }
  .section-tag {
    font-size: 0.68rem; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--champagne); margin-bottom: 1rem;
    display: flex; align-items: center; gap: 10px;
  }
  .section-tag::before { content: ''; width: 28px; height: 1px; background: var(--champagne); }
  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 500; line-height: 1.15;
    color: var(--text-dark); margin-bottom: 1.25rem;
  }
  .section-title em { font-style: italic; color: var(--rose-gold); }
  .section-sub {
    font-size: 1rem; line-height: 1.8; color: #777;
    max-width: 520px;
  }

  /* ── BRAND STORY ── */
  .story-section {
    background: var(--warm-ivory);
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 6rem; align-items: center;
  }
  .story-visual { position: relative; }
  .story-img-frame {
    width: 100%; aspect-ratio: 3/4;
    border-radius: 24px;
    background: linear-gradient(145deg, var(--soft-blush), #DFC5BC);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 1rem; font-size: 5rem;
    overflow: hidden;
    position: relative;
  }
  .story-img-frame::before {
    content: ''; position: absolute; inset: 0;
    background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.4), transparent 60%);
  }
  .story-float-card {
    position: absolute; bottom: -20px; right: -20px;
    background: white; border-radius: 16px;
    padding: 1.2rem 1.5rem;
    box-shadow: 0 12px 40px rgba(183,110,121,0.15);
    min-width: 170px;
  }
  .float-card-title { font-family: 'Playfair Display', serif; font-size: 1.4rem; font-weight: 600; color: var(--rose-gold); }
  .float-card-label { font-size: 0.72rem; color: #999; margin-top: 2px; }
  .story-text { padding-right: 2rem; }
  .story-text .section-title { margin-bottom: 1.5rem; }
  .story-text p { font-size: 0.95rem; line-height: 1.9; color: #666; margin-bottom: 1.2rem; }
  .story-pillars {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
    margin-top: 2rem;
  }
  .pillar {
    padding: 1.2rem 1.4rem; border-radius: 14px;
    border: 1px solid var(--border-light);
    background: white;
  }
  .pillar-icon { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .pillar-title { font-weight: 600; font-size: 0.85rem; color: var(--text-dark); margin-bottom: 0.25rem; }
  .pillar-desc { font-size: 0.78rem; color: #999; line-height: 1.6; }

  /* ── PRODUCTS ── */
  .products-section { background: var(--soft-bg); }
  .products-header { text-align: center; margin-bottom: 3.5rem; }
  .products-header .section-tag { justify-content: center; }
  .products-header .section-tag::before { display: none; }
  .products-header .section-sub { margin: 0 auto; text-align: center; }
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .product-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border-light);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    cursor: pointer;
  }
  .product-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(183,110,121,0.14); }
  .product-img {
    aspect-ratio: 1/1;
    display: flex; align-items: center; justify-content: center;
    font-size: 5rem; position: relative;
    overflow: hidden;
  }
  .product-img::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, transparent 60%, rgba(0,0,0,0.04));
  }
  .product-img-bg-1 { background: linear-gradient(135deg, #F0DDD9, #E8D0CA); }
  .product-img-bg-2 { background: linear-gradient(135deg, #E8EDD8, #D8E0C8); }
  .product-img-bg-3 { background: linear-gradient(135deg, #DDE8EF, #CCDAE6); }
  .product-img-bg-4 { background: linear-gradient(135deg, #EDE4D8, #E0D4C2); }
  .product-img-bg-5 { background: linear-gradient(135deg, #EDD8E4, #E0C4D8); }
  .product-img-bg-6 { background: linear-gradient(135deg, #E8E0D8, #DDD4C8); }
  .product-badge {
    position: absolute; top: 16px; left: 16px; z-index: 1;
    background: var(--champagne); color: #5A3A0A;
    font-size: 0.65rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 4px 10px; border-radius: 50px;
  }
  .product-info { padding: 1.5rem; }
  .product-category {
    font-size: 0.65rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted-rose); margin-bottom: 0.5rem;
  }
  .product-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem; font-weight: 500;
    color: var(--text-dark); margin-bottom: 0.5rem; line-height: 1.3;
  }
  .product-desc { font-size: 0.8rem; color: #999; line-height: 1.6; margin-bottom: 1.2rem; }
  .product-footer { display: flex; align-items: center; justify-content: space-between; }
  .product-price {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem; font-weight: 600;
    color: var(--rose-gold);
  }
  .product-btn {
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--soft-blush);
    border: none; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; color: var(--rose-gold);
    transition: all 0.2s;
  }
  .product-btn:hover { background: var(--rose-gold); color: white; transform: scale(1.1); }
  .products-cta { text-align: center; margin-top: 3rem; }

  /* ── BENEFITS ── */
  .benefits-section {
    background: linear-gradient(135deg, var(--rose-gold) 0%, #A35A68 100%);
    color: white;
  }
  .benefits-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 2rem; margin-top: 3.5rem;
  }
  .benefit-item { text-align: center; padding: 1rem; }
  .benefit-icon {
    width: 70px; height: 70px; border-radius: 50%;
    background: rgba(255,255,255,0.12);
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem; margin: 0 auto 1.25rem;
    border: 1px solid rgba(255,255,255,0.2);
  }
  .benefit-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; font-weight: 500; margin-bottom: 0.5rem; }
  .benefit-desc { font-size: 0.82rem; line-height: 1.7; opacity: 0.8; }
  .benefits-section .section-tag { color: var(--champagne); }
  .benefits-section .section-tag::before { background: var(--champagne); }
  .benefits-section .section-title { color: white; }
  .benefits-section .section-sub { color: rgba(255,255,255,0.75); }

  /* ── CATEGORIES ── */
  .categories-section { background: var(--warm-ivory); }
  .categories-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem; margin-top: 3rem;
  }
  .category-card {
    border-radius: 20px; overflow: hidden;
    position: relative; aspect-ratio: 4/5;
    cursor: pointer;
    transition: transform 0.3s ease;
  }
  .category-card:hover { transform: translateY(-4px); }
  .category-card:hover .category-overlay { background: rgba(0,0,0,0.35); }
  .cat-bg {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    font-size: 6rem;
  }
  .cat-bg-1 { background: linear-gradient(160deg, #F5DDD8 0%, #E8C8C0 100%); }
  .cat-bg-2 { background: linear-gradient(160deg, #EDE4D8 0%, #E0D0C0 100%); }
  .cat-bg-3 { background: linear-gradient(160deg, #D8E8E0 0%, #C8DDD4 100%); }
  .cat-bg-4 { background: linear-gradient(160deg, #E8DFF0 0%, #DDD0E8 100%); }
  .cat-bg-5 { background: linear-gradient(160deg, #F0E8D8 0%, #E4D8C0 100%); }
  .cat-bg-6 { background: linear-gradient(160deg, #E0E8F0 0%, #D0DDE8 100%); }
  .category-overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.2);
    transition: background 0.3s;
    display: flex; flex-direction: column;
    justify-content: flex-end; padding: 1.8rem;
  }
  .category-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem; font-weight: 500;
    color: white; margin-bottom: 0.4rem;
  }
  .category-count { font-size: 0.78rem; color: rgba(255,255,255,0.7); letter-spacing: 0.05em; }
  .category-card.large { grid-column: span 2; }
  .category-card.large .cat-bg { font-size: 8rem; }
  .category-card.large .category-name { font-size: 1.6rem; }

  /* ── TESTIMONIALS ── */
  .testimonials-section { background: var(--soft-bg); }
  .testimonials-header { text-align: center; margin-bottom: 3.5rem; }
  .testimonials-header .section-tag { justify-content: center; }
  .testimonials-header .section-tag::before { display: none; }
  .testimonials-grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .testimonial-card {
    background: white;
    border-radius: 20px;
    padding: 2rem;
    border: 1px solid var(--border-light);
    position: relative;
    transition: transform 0.3s, box-shadow 0.3s;
  }
  .testimonial-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(183,110,121,0.1); }
  .testimonial-card.featured {
    background: linear-gradient(135deg, var(--soft-blush), #F0E0DA);
    border-color: rgba(183,110,121,0.25);
  }
  .testimonial-stars { color: var(--champagne); font-size: 0.9rem; margin-bottom: 1rem; letter-spacing: 2px; }
  .testimonial-text {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem; line-height: 1.7; color: var(--text-dark);
    font-style: italic; margin-bottom: 1.5rem;
  }
  .testimonial-author { display: flex; align-items: center; gap: 12px; }
  .author-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: var(--soft-blush);
    display: flex; align-items: center; justify-content: center;
    font-weight: 600; font-size: 0.85rem; color: var(--rose-gold);
    flex-shrink: 0;
  }
  .author-name { font-weight: 600; font-size: 0.88rem; color: var(--text-dark); }
  .author-city { font-size: 0.72rem; color: #aaa; }

  /* ── LIFESTYLE ── */
  .lifestyle-section { background: var(--warm-ivory); }
  .lifestyle-grid {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: 3rem; align-items: center; margin-top: 3rem;
  }
  .lifestyle-features { display: flex; flex-direction: column; gap: 1.5rem; }
  .lifestyle-feature { display: flex; gap: 1.25rem; align-items: flex-start; }
  .feature-icon-wrap {
    width: 50px; height: 50px; border-radius: 14px;
    background: var(--soft-blush);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; flex-shrink: 0;
  }
  .feature-title { font-weight: 600; font-size: 0.95rem; color: var(--text-dark); margin-bottom: 0.35rem; }
  .feature-desc { font-size: 0.82rem; color: #888; line-height: 1.7; }
  .lifestyle-visual {
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: auto auto;
    gap: 1rem;
  }
  .lifestyle-tile {
    border-radius: 16px; padding: 1.8rem;
    display: flex; flex-direction: column;
    align-items: flex-start; gap: 0.75rem;
  }
  .tile-1 { background: var(--soft-blush); grid-row: span 2; }
  .tile-2 { background: linear-gradient(135deg, var(--champagne), #E8C88A); }
  .tile-3 { background: linear-gradient(135deg, #D8E8E4, #C8DDD8); }
  .lifestyle-tile-icon { font-size: 2.5rem; }
  .lifestyle-tile-title { font-family: 'Playfair Display', serif; font-size: 1rem; font-weight: 500; color: var(--text-dark); }
  .lifestyle-tile-desc { font-size: 0.78rem; color: #888; line-height: 1.6; }

  /* ── OPPORTUNITY ── */
  .opportunity-section {
    background: var(--text-dark);
    color: white;
  }
  .opportunity-grid {
    display: grid; grid-template-columns: 1fr 1.2fr;
    gap: 5rem; align-items: center;
  }
  .opportunity-section .section-tag { color: var(--champagne); }
  .opportunity-section .section-tag::before { background: var(--champagne); }
  .opportunity-section .section-title { color: white; }
  .opportunity-section .section-sub { color: rgba(255,255,255,0.65); }
